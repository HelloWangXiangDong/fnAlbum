<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/panel_bg"
        android:padding="24dp">

        <!-- ==================== 左：遥控器手动填写 ==================== -->
        <LinearLayout
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dlgTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:text="添加账号" />

            <TextView
                android:id="@+id/dlgSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:textColor="#8FA3BF"
                android:textSize="14sp"
                android:text="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#9FB0C6"
                        android:textSize="14sp"
                        android:text="服务器地址（IP 或域名）" />

                    <EditText
                        android:id="@+id/edHost"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/field_bg"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:inputType="textUri"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:hint="如 192.168.1.100"
                        android:textColorHint="#5C6B80" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#9FB0C6"
                        android:textSize="14sp"
                        android:text="端口" />

                    <EditText
                        android:id="@+id/edPort"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/field_bg"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:inputType="number"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:text="5666"
                        android:textColorHint="#5C6B80" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#9FB0C6"
                android:textSize="14sp"
                android:text="账号" />

            <EditText
                android:id="@+id/edUser"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textColorHint="#5C6B80" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#9FB0C6"
                android:textSize="14sp"
                android:text="密码（自动记住）" />

            <EditText
                android:id="@+id/edPass"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textColorHint="#5C6B80" />

            <TextView
                android:id="@+id/tvErr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#FF7B72"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnTest"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/field_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:textColor="#E4ECF7"
                    android:textSize="17sp"
                    android:text="测试连接" />

                <TextView
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/field_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:textColor="#E4ECF7"
                    android:textSize="17sp"
                    android:text="保存并登录" />
            </LinearLayout>

        </LinearLayout>

        <!-- ==================== 右：手机扫码填写 ==================== -->
        <View
            android:id="@+id/qrDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="22dp"
            android:background="#1E2C3E" />

        <LinearLayout
            android:id="@+id/qrBox"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="手机扫码填写" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="#8FA3BF"
                android:textSize="13sp"
                android:text="手机与电视连同一个网络，扫码后在手机上输入，不用遥控器慢慢敲" />

            <FrameLayout
                android:layout_width="248dp"
                android:layout_height="248dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/qr_frame_bg"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/imgQr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="扫码登录二维码" />

                <ProgressBar
                    android:id="@+id/qrLoading"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvQrUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#5C6B80"
                android:textSize="11sp"
                android:maxLines="2"
                android:text="" />

            <TextView
                android:id="@+id/tvQrState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#9FB0C6"
                android:textSize="13sp"
                android:text="正在启动…" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
