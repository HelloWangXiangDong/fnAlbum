<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!--
        顺序很重要：播放画面必须排在下面，静态图排在它**之上**。
        这里放的是 SurfaceView（由 ExoPlayer 接管），它同样会把自己的区域挖空，
        绘制在它之前的兄弟视图会被清掉；只有排在后面的兄弟视图才能盖住它。
        播放加载期间就靠这层静态图遮住视频的黑底。
    -->
    <SurfaceView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/imgFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:contentDescription="photo" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- 右上角媒体角标：视频 / 动图 -->
    <LinearLayout
        android:id="@+id/viewerBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@drawable/badge_bg"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgViewerBadge"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="media type" />

        <TextView
            android:id="@+id/tvViewerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/infoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:background="#99000000">

        <TextView
            android:id="@+id/tvFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:maxLines="1"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#A8B8CC"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvViewerHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#99000000"
        android:textColor="#C9D4E4"
        android:textSize="14sp"
        android:text="← → 上一张 / 下一张     BACK 返回" />

</FrameLayout>
